# ScholarSwarm Environment Configuration
# Provide an API key for any OpenAI-compatible provider (Groq, OpenAI, Gemini, etc.)

# Option 1: Groq (Recommended for ultra-fast free/low-cost inference)
# Sign up at https://console.groq.com and paste your API key below:
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Option 2: OpenAI (e.g., gpt-4o-mini, gpt-4o)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Option 3: Google Gemini (via OpenAI-compatible endpoint)
# LLM_API_KEY=AIzaSy...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# Live Search (Optional: Tavily API key for enhanced web search; falls back to DuckDuckGo browser search)
TAVILY_API_KEY=

# GitHub API Token (Optional: raises rate limits when analyzing public repositories)
GITHUB_TOKEN=

# Swarm Crawl Settings
LIVE_FETCH=1
LIVE_DISCOVERY=1
MAX_CONCURRENCY=5
FETCH_TIMEOUT=12

